<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voucher Entri Transaksi Kas Keluar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-600 text-white p-2 rounded-xl shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 leading-tight">Modul Akuntansi: Kas Keluar</h1>
                    <p class="text-xs text-slate-500">Sistem Entri Voucher Jurnal Transaksi</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <span id="connectionStatus" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                    <span class="w-2 h-2 mr-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                    Sistem Terhubung
                </span>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Custom Notification Modal (Zero Alert policy) -->
        <div id="customModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl transform transition-all">
                <div id="modalIconContainer" class="w-12 h-12 rounded-full flex items-center justify-center mb-4 mx-auto">
                    <!-- Icon injected via JS -->
                </div>
                <h3 id="modalTitle" class="text-lg font-bold text-center text-slate-900 mb-2"></h3>
                <p id="modalMessage" class="text-sm text-slate-600 text-center mb-6"></p>
                <div class="flex justify-center">
                    <button onclick="closeModal()" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-medium py-2.5 px-4 rounded-xl transition-colors cursor-pointer">
                        Mengerti
                    </button>
                </div>
            </div>
        </div>

        <form id="voucherForm" onsubmit="handleSubmit(event)" class="space-y-6">
            
            <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                    <h2 class="text-base font-semibold text-slate-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                        </svg>
                        Informasi Header Transaksi
                    </h2>
                    <span class="text-xs font-medium text-slate-400">* Wajib diisi</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="voucherDate">Tanggal Transaksi</label>
                        <input type="date" id="voucherDate" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="referenceNo">Nomor Referensi (Voucher)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-xs font-semibold text-slate-400">BKK/</span>
                            <input type="text" id="referenceNo" required value="2026/10/001" class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-12 pr-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all uppercase">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2" for="description">Keterangan / Memo Umum</label>
                        <input type="text" id="description" required placeholder="Contoh: Pembayaran Biaya Operasional Kantor" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 overflow-hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 pb-3 border-b border-slate-100 gap-3">
                    <div>
                        <h2 class="text-base font-semibold text-slate-900 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                            </svg>
                            Rincian Baris Jurnal Akuntansi
                        </h2>
                        <p class="text-xs text-slate-500">Pastikan total sisi Debit dan Kredit bernilai sama (Zero-Discrepancy)</p>
                    </div>
                    <button type="button" onclick="addRow()" class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold px-4 py-2.5 rounded-xl transition-colors cursor-pointer border border-slate-200">
                        <svg class="w-4 h-4 mr-1.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Tambah Baris
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                                <th class="py-3 px-4 w-12 text-center">#</th>
                                <th class="py-3 px-4 w-5/12">Akun Chart of Accounts (COA)</th>
                                <th class="py-3 px-4 w-3/12">Debit (IDR)</th>
                                <th class="py-3 px-4 w-3/12">Kredit (IDR)</th>
                                <th class="py-3 px-4 w-16 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="journalRowsContainer" class="divide-y divide-slate-100 text-sm">
                            <!-- Rows inserted dynamically via script -->
                        </tbody>
                    </table>
                </div>

                <div class="mt-6 pt-6 border-t border-slate-100 grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
                    
                    <!-- Indikator Visual Status -->
                    <div id="statusIndicatorBox" class="p-4 rounded-xl border flex items-center space-x-3 bg-amber-50 border-amber-200 text-amber-900 transition-all duration-300">
                        <div id="statusIcon" class="p-2 rounded-lg bg-amber-100 text-amber-700">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 id="statusTitle" class="text-xs font-bold uppercase tracking-wider">Belum Seimbang</h4>
                            <p id="statusDesc" class="text-xs opacity-80">Total Debit & Kredit belum sama atau masih kosong.</p>
                        </div>
                    </div>

                    <!-- Ringkasan Nilai -->
                    <div class="grid grid-cols-3 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200/60 lg:col-span-2">
                        <div>
                            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Debit</span>
                            <span id="displayTotalDebit" class="text-sm sm:text-base font-bold text-slate-900">Rp 0</span>
                        </div>
                        <div>
                            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Kredit</span>
                            <span id="displayTotalKredit" class="text-sm sm:text-base font-bold text-slate-900">Rp 0</span>
                        </div>
                        <div>
                            <span class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Selisih (Discrepancy)</span>
                            <span id="displaySelisih" class="text-sm sm:text-base font-bold text-amber-600">Rp 0</span>
                        </div>
                    </div>

                </div>

                <!-- Action Submit Button -->
                <div class="mt-6 pt-4 flex justify-end">
                    <button type="submit" id="submitBtn" disabled class="bg-blue-600 hover:bg-blue-700 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed text-white font-semibold py-3 px-8 rounded-xl shadow-xs transition-all duration-200 flex items-center space-x-2 cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>Submit Voucher Kas Keluar</span>
                    </button>
                </div>
            </section>

        </form>
    </main>

    <script>
        // Data Master COA (Chart of Accounts) standar akuntansi
        const coaList = [
            { code: "1-1110", name: "1-1110 - Kas Kecil (Petty Cash)", type: "Asset" },
            { code: "1-1120", name: "1-1120 - Kas di Bank (BCA / Mandiri)", type: "Asset" },
            { code: "2-1110", name: "2-1110 - Hutang Usaha (Accounts Payable)", type: "Liability" },
            { code: "2-1210", name: "2-1210 - Biaya yang Harus Dibayar (Accrued Expenses)", type: "Liability" },
            { code: "5-1110", name: "5-1110 - Beban Gaji & Upah Karyawan", type: "Expense" },
            { code: "5-1210", name: "5-1210 - Beban Sewa Kantor & Gedung", type: "Expense" },
            { code: "5-1310", name: "5-1310 - Beban Listrik, Air, & Internet (UTILITIES)", type: "Expense" },
            { code: "5-1410", name: "5-1410 - Beban Perlengkapan Kantor (Supplies)", type: "Expense" },
            { code: "5-1510", name: "5-1510 - Beban Perbaikan & Pemeliharaan", type: "Expense" },
            { code: "5-1990", name: "5-1990 - Beban Operasional Lain-lain (Misc Expense)", type: "Expense" }
        ];

        let rowsData = [
            { id: 1, coa: "5-1310", debit: 1500000, kredit: 0 },
            { id: 2, coa: "1-1120", debit: 0, kredit: 1500000 }
        ];

        let nextRowId = 3;

        // Mengatur tanggal default hari ini
        document.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('voucherDate').value = today;
            renderRows();
            calculateTotals();
        });

        // Menambah Baris Jurnal Baru
        function addRow() {
            rowsData.push({
                id: nextRowId++,
                coa: "5-1110",
                debit: 0,
                kredit: 0
            });
            renderRows();
            calculateTotals();
        }

        // Menghapus Baris Jurnal
        function deleteRow(id) {
            if (rowsData.length <= 2) {
                showModal('Peringatan Minimum Baris', 'Voucher jurnal akuntansi minimal memerlukan 2 baris transaksi (Sisi Debit dan Kredit).', 'warning');
                return;
            }
            rowsData = rowsData.filter(row => row.id !== id);
            renderRows();
            calculateTotals();
        }

        // Render Tabel Baris
        function renderRows() {
            const container = document.getElementById('journalRowsContainer');
            container.innerHTML = '';

            rowsData.forEach((row, index) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/50 transition-colors";
                
                // Opsi COA Dropdown
                let coaOptions = '';
                coaList.forEach(item => {
                    const selected = item.code === row.coa ? 'selected' : '';
                    coaOptions += `<option value="${item.code}" ${selected}>${item.name}</option>`;
                });

                tr.innerHTML = `
                    <td class="py-3 px-4 text-center text-xs font-semibold text-slate-400">${index + 1}</td>
                    <td class="py-3 px-4">
                        <select onchange="updateRowData(${row.id}, 'coa', this.value)" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                            ${coaOptions}
                        </select>
                    </td>
                    <td class="py-3 px-4">
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs text-slate-400">Rp</span>
                            <input type="number" min="0" step="100" value="${row.debit}" oninput="updateRowData(${row.id}, 'debit', parseFloat(this.value) || 0)" class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                        </div>
                    </td>
                    <td class="py-3 px-4">
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs text-slate-400">Rp</span>
                            <input type="number" min="0" step="100" value="${row.kredit}" oninput="updateRowData(${row.id}, 'kredit', parseFloat(this.value) || 0)" class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                        </div>
                    </td>
                    <td class="py-3 px-4 text-center">
                        <button type="button" onclick="deleteRow(${row.id})" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Hapus Baris">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                        </button>
                    </td>
                `;
                container.appendChild(tr);
            });
        }

        // Update state nilai baris real-time
        function updateRowData(id, field, value) {
            const row = rowsData.find(r => r.id === id);
            if (row) {
                row[field] = value;
                calculateTotals();
            }
        }

        // Kalkulasi Otomatis Real-time & Validasi Zero-Discrepancy
        function calculateTotals() {
            let totalDebit = 0;
            let totalKredit = 0;

            rowsData.forEach(row => {
                totalDebit += Number(row.debit) || 0;
                totalKredit += Number(row.kredit) || 0;
            });

            const discrepancy = Math.abs(totalDebit - totalKredit);
            const isBalanced = (totalDebit === totalKredit) && (totalDebit > 0);

            // Format ke Rupiah
            const formatIDR = (num) => 'Rp ' + num.toLocaleString('id-ID');

            document.getElementById('displayTotalDebit').textContent = formatIDR(totalDebit);
            document.getElementById('displayTotalKredit').textContent = formatIDR(totalKredit);
            document.getElementById('displaySelisih').textContent = formatIDR(discrepancy);

            const statusBox = document.getElementById('statusIndicatorBox');
            const statusIcon = document.getElementById('statusIcon');
            const statusTitle = document.getElementById('statusTitle');
            const statusDesc = document.getElementById('statusDesc');
            const submitBtn = document.getElementById('submitBtn');

            if (isBalanced) {
                // Status Seimbang
                statusBox.className = "p-4 rounded-xl border flex items-center space-x-3 bg-emerald-50 border-emerald-200 text-emerald-900 transition-all duration-300";
                statusIcon.className = "p-2 rounded-lg bg-emerald-100 text-emerald-700";
                statusIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
                statusTitle.textContent = "Seimbang (Zero Discrepancy)";
                statusDesc.textContent = "Total Debit dan Kredit bernilai sama. Voucher siap disubmit.";
                displaySelisih.className = "text-sm sm:text-base font-bold text-emerald-600";
                
                // Aktifkan tombol submit
                submitBtn.removeAttribute('disabled');
            } else {
                // Status Belum Seimbang
                statusBox.className = "p-4 rounded-xl border flex items-center space-x-3 bg-amber-50 border-amber-200 text-amber-900 transition-all duration-300";
                statusIcon.className = "p-2 rounded-lg bg-amber-100 text-amber-700";
                statusIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
                statusTitle.textContent = "Belum Seimbang / Zero Discrepancy Gagal";
                statusDesc.textContent = totalDebit === 0 && totalKredit === 0 ? "Nilai transaksi masih kosong." : `Terdapat selisih sebesar ${formatIDR(discrepancy)}.`;
                displaySelisih.className = "text-sm sm:text-base font-bold text-amber-600";
                
                // Kunci tombol submit
                submitBtn.setAttribute('disabled', 'true');
            }
        }

        // Fungsi Submit Voucher ke Sistem Akuntansi
        function handleSubmit(event) {
            event.preventDefault();
            
            // Validasi akhir sebelum submit
            let totalDebit = rowsData.reduce((acc, r) => acc + (Number(r.debit) || 0), 0);
            let totalKredit = rowsData.reduce((acc, r) => acc + (Number(r.kredit) || 0), 0);

            if (totalDebit !== totalKredit || totalDebit <= 0) {
                showModal('Gagal Menyimpan Voucher', 'Asas zero-discrepancy tidak terpenuhi. Periksa kembali keseimbangan debit dan kredit.', 'error');
                return;
            }

            const voucherPayload = {
                date: document.getElementById('voucherDate').value,
                referenceNo: "BKK/" + document.getElementById('referenceNo').value,
                description: document.getElementById('description').value,
                rows: rowsData,
                totalAmount: totalDebit,
                timestamp: new Date().toISOString()
            };

            // Simulasi pengiriman data ke server basis data akuntansi
            console.log("Mengirim Voucher ke Database Akuntansi:", voucherPayload);
            
            showModal(
                'Voucher Berhasil Disubmit!', 
                `Transaksi Kas Keluar dengan Nomor Referensi <b>${voucherPayload.referenceNo}</b> berhasil dicatat dan diposting ke Buku Besar sistem akuntansi.`, 
                'success'
            );
        }

        // Modifikasi Modal Kustom Pengganti Alert Bawaan Browser
        function showModal(title, message, type) {
            const modal = document.getElementById('customModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalMessage = document.getElementById('modalMessage');
            const modalIconContainer = document.getElementById('modalIconContainer');

            modalTitle.textContent = title;
            modalMessage.innerHTML = message;

            if (type === 'success') {
                modalIconContainer.className = "w-12 h-12 rounded-full flex items-center justify-center mb-4 mx-auto bg-emerald-100 text-emerald-600";
                modalIconContainer.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
            } else if (type === 'warning') {
                modalIconContainer.className = "w-12 h-12 rounded-full flex items-center justify-center mb-4 mx-auto bg-amber-100 text-amber-600";
                modalIconContainer.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
            } else {
                modalIconContainer.className = "w-12 h-12 rounded-full flex items-center justify-center mb-4 mx-auto bg-rose-100 text-rose-600";
                modalIconContainer.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
            }

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('customModal').classList.add('hidden');
        }
    </script>
</body>
