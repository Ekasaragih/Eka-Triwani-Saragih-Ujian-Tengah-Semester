-- =========================================================
-- 1. TABEL CHART_OF_ACCOUNTS
-- Menyimpan daftar akun buku besar.
-- =========================================================

CREATE TABLE chart_of_accounts (
    account_id BIGINT GENERATED ALWAYS AS IDENTITY,
    account_code VARCHAR(20) NOT NULL,
    account_name VARCHAR(100) NOT NULL,
    normal_balance VARCHAR(6) NOT NULL,
    report_class VARCHAR(20) NOT NULL,

    CONSTRAINT pk_chart_of_accounts
        PRIMARY KEY (account_id),

    CONSTRAINT uq_chart_of_accounts_code
        UNIQUE (account_code),

    CONSTRAINT chk_account_code_not_empty
        CHECK (LENGTH(TRIM(account_code)) > 0),

    CONSTRAINT chk_account_name_not_empty
        CHECK (LENGTH(TRIM(account_name)) > 0),

    CONSTRAINT chk_normal_balance
        CHECK (normal_balance IN ('DEBIT', 'CREDIT')),

    CONSTRAINT chk_report_class
        CHECK (
            report_class IN (
                'ASSET',
                'LIABILITY',
                'EQUITY',
                'REVENUE',
                'EXPENSE'
            )
        )
);


-- =========================================================
-- 2. TABEL JOURNAL_HEADERS
-- Menyimpan informasi utama setiap transaksi jurnal.
-- =========================================================

CREATE TABLE journal_headers (
    header_id BIGINT GENERATED ALWAYS AS IDENTITY,
    transaction_date DATE NOT NULL,
    reference_no VARCHAR(50) NOT NULL,
    description TEXT,
    posting_status VARCHAR(10) NOT NULL DEFAULT 'DRAFT',

    CONSTRAINT pk_journal_headers
        PRIMARY KEY (header_id),

    CONSTRAINT uq_journal_reference
        UNIQUE (reference_no),

    CONSTRAINT chk_reference_not_empty
        CHECK (LENGTH(TRIM(reference_no)) > 0),

    CONSTRAINT chk_posting_status
        CHECK (posting_status IN ('DRAFT', 'POSTED'))
);


-- =========================================================
-- 3. TABEL JOURNAL_LINES
-- Menyimpan rincian akun dan nominal debit/kredit.
-- =========================================================

CREATE TABLE journal_lines (
    line_id BIGINT GENERATED ALWAYS AS IDENTITY,
    header_id BIGINT NOT NULL,
    account_id BIGINT NOT NULL,
    debit NUMERIC(18,2) NOT NULL DEFAULT 0,
    credit NUMERIC(18,2) NOT NULL DEFAULT 0,

    CONSTRAINT pk_journal_lines
        PRIMARY KEY (line_id),

    -- Relasi dengan tabel journal_headers
    CONSTRAINT fk_journal_lines_header
        FOREIGN KEY (header_id)
        REFERENCES journal_headers (header_id)
        ON DELETE RESTRICT
        ON UPDATE RESTRICT,

    -- Relasi dengan tabel chart_of_accounts
    CONSTRAINT fk_journal_lines_account
        FOREIGN KEY (account_id)
        REFERENCES chart_of_accounts (account_id)
        ON DELETE RESTRICT
        ON UPDATE RESTRICT,

    -- Debit tidak boleh negatif
    CONSTRAINT chk_debit_nonnegative
        CHECK (debit >= 0),

    -- Kredit tidak boleh negatif
    CONSTRAINT chk_credit_nonnegative
        CHECK (credit >= 0),

    -- Debit dan kredit tidak boleh sama-sama nol
    CONSTRAINT chk_debit_or_credit_nonzero
        CHECK (debit > 0 OR credit > 0),

    -- Satu baris hanya boleh mencatat debit atau kredit
    CONSTRAINT chk_debit_credit_one_side
        CHECK (debit = 0 OR credit = 0)
);


-- =========================================================
-- 4. INDEX UNTUK FOREIGN KEY
-- Membantu pencarian rincian jurnal berdasarkan header
-- maupun akun. PostgreSQL tidak otomatis membuat index
-- pada kolom foreign key di tabel anak.
-- =========================================================

CREATE INDEX idx_journal_lines_header_id
    ON journal_lines (header_id);

CREATE INDEX idx_journal_lines_account_id
    ON journal_lines (account_id);


